# Claude/local state
.claude/settings.local.json
# The operator's standing lane choice (scripts/lane.py): one machine's setup, never shared.
.claude/routing-lane.local
# Worktrees scripts/codex_cli.py gives the Codex CLI to write in.
.codex-worktrees/

# Generated artifacts (keep folders, ignore run outputs)
artifacts/architecture/*
!artifacts/architecture/.gitkeep
artifacts/critiques/*
!artifacts/critiques/.gitkeep
artifacts/plans/*
!artifacts/plans/.gitkeep
artifacts/reviews/*
!artifacts/reviews/.gitkeep

# Session handoff is local session state, not repository content:
# it quotes the last prompt and the working tree of one machine's run.
artifacts/handoff/*
!artifacts/handoff/.gitkeep

# OS/editor
.DS_Store
.vscode/
.idea/

# Python
__pycache__/
*.pyc
.pytest_cache/

# Web UI (build output and dependencies)
web/node_modules/
web/dist/

# Runs and secrets
*.local
